# Builds the master branch from GitHub:
#   cd dist/arch && makepkg -si
# To build a local clone instead, e.g. to try changes before publishing them:
#   LIGHTSPILL_SOURCE="git+file://$HOME/git/lightspill#branch=master" makepkg -si
# Needs cpp-httplib 0.46 or newer, installed from source (see README), so it isn't listed

pkgname=lightspill
pkgver=1.2.0
pkgrel=1
pkgdesc="Screen and sound sync for Philips Hue lamps on Linux (Wayland)"
arch=('x86_64')
license=('GPL-3.0-only')
depends=(
  'brotli'
  'curl'
  'glib2'
  'libdrm'
  'libglvnd'
  'mbedtls'
  'opencv'
  'pipewire'
  'qt6-base'
  'qt6-svg'
  'qt6-webengine'
  'xdg-desktop-portal'
)
makedepends=('cmake' 'git' 'glm' 'nlohmann-json')
install=lightspill.install
# Former name of the package
provides=('hue-desktop-sync')
conflicts=('hue-desktop-sync')
replaces=('hue-desktop-sync')
source=("$pkgname::${LIGHTSPILL_SOURCE:-git+https://github.com/derPhili/lightspill.git#branch=master}")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local version
  version=$(sed -n 's/^project(Lightspill VERSION \([0-9.]*\))$/\1/p' CMakeLists.txt)
  printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S "$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTS=OFF \
    -DBUILD_GUI=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
