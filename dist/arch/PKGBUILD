# Builds the master branch from GitHub:
#   cd dist/arch && makepkg -si
# To build a local clone instead, e.g. to try changes before publishing them:
#   HALOMUX_SOURCE="git+file://$HOME/git/halomux#branch=master" makepkg -si
# Needs cpp-httplib 0.46 or newer, installed from source (see README), so it isn't listed

pkgname=halomux
pkgver=1.2.0
pkgrel=1
pkgdesc="Screen and sound sync for Philips Hue lamps on Linux (Wayland)"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-only AND AGPL-3.0-only')
depends=(
  'brotli'
  'curl'
  'glib2'
  'libdrm'
  'libglvnd'
  'mbedtls>=4'
  'opencv'
  'openssl'
  'pipewire'
  'qt6-base'
  'qt6-svg'
  'qt6-webengine'
  'wayland'
  'zlib'
  'zstd'
  'xdg-desktop-portal'
)
makedepends=('cmake' 'git' 'glm' 'nlohmann-json' 'wayland-protocols')
install=halomux.install
# Former name of the package
provides=('lightspill' 'hue-desktop-sync')
conflicts=('lightspill' 'hue-desktop-sync')
replaces=('lightspill' 'hue-desktop-sync')
source=("$pkgname::${HALOMUX_SOURCE:-git+https://github.com/derPhili/halomux.git#branch=master}")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  local version
  version=$(sed -n 's/^project(Halomux VERSION \([0-9.]*\))$/\1/p' CMakeLists.txt)
  printf "%s.r%s.g%s" "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S "$pkgname" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTS=OFF \
    -DBUILD_GUI=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
