[Unit]
Description=Philip's Hue Desktop Sync
Documentation=file://%h/git/huenicorn/README.md
# Needs the Wayland session, Pipewire and the screencast portal
PartOf=graphical-session.target
After=graphical-session.target pipewire.service xdg-desktop-portal.service
Wants=xdg-desktop-portal.service

[Service]
Type=simple
ExecStart=%h/.local/bin/hue-desktop-sync
# SIGTERM lets it close the DTLS session and stop streaming on the bridge
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
